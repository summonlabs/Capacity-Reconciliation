#
# CMake package configuration for Capacity Reconciliation.
#
# The package has no third-party dependency beyond the C++20 standard library
# and, on Windows, the operating system libraries that ship with the platform.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/CapacityReconciliationTargets.cmake")

set(CapacityReconciliation_VERSION "@PROJECT_VERSION@")
set(CAPACITY_RECONCILIATION_VERSION "@PROJECT_VERSION@")

check_required_components(CapacityReconciliation)
